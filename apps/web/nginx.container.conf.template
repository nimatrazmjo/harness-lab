# Containerized nginx config for apps/web — serves the built Vite bundle and proxies /api/*.
# Mirrors infra/nginx.conf's rewrite/proxy rules (that file is the real EC2-host nginx, which
# also terminates TLS on 443; this one is just the app-serving piece for a container/compose
# context — no TLS here, that stays the host nginx's job per AGENTS.md [RDS-PRIVATE]).
#
# Processed by nginxinc/nginx-unprivileged's built-in envsubst-on-templates entrypoint at
# container start (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf), substituting
# ${API_UPSTREAM}. Default is a literal IP (set in apps/web/Dockerfile) so nginx never fails to
# *start* even with no API container linked — only requests that actually hit /api/* need a
# real upstream.

server {
    listen 8080;
    server_name _;

    # SSE endpoint (note generation) must not be buffered — buffering turns progressive
    # streaming into spinner-then-dump. Matches infra/nginx.conf's identical rule for
    # POST /encounters/:id/scribe/generate.
    location ~ ^/api/(encounters/[^/]+/scribe/.*)$ {
        proxy_pass ${API_UPSTREAM}/$1;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        add_header X-Accel-Buffering no;
    }

    # Frontend calls /api/*; the Nest app's own routes are unprefixed (/auth, /encounters, ...)
    # — strip /api here the same way infra/nginx.conf and apps/web/vite.config.ts's dev proxy do.
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
