# Docker smoke-test env file for `apps/api/Dockerfile` (devops.dockerfile_api verify commands:
# `docker run --env-file apps/api/.env.example ...`). Shape/local-only values, no real secrets —
# see root `.env.example` for the full local-dev-outside-docker variant.
#
# NODE_ENV is intentionally NOT "production": apps/api/src/main.ts binds 127.0.0.1 only in
# production (nginx is assumed to be the only thing reachable on the host in real prod), which
# would break `docker run -p 3099:3000` port publishing here. Non-production also makes
# apps/api/src/config/secrets.ts read DATABASE_URL/JWT_SECRET straight from env instead of
# calling AWS Secrets Manager, so this smoke test needs no AWS access at all.
NODE_ENV=development

PORT=3000

# host.docker.internal reaches the host's already-running infra/docker-compose.yml postgres
# (scribe-postgres, published on host port 5433) from inside the container. GET /health queries
# this DB directly, so it must be reachable for the verify command's `curl -f .../health` to
# return 200.
DATABASE_URL=postgres://scribe:scribe@host.docker.internal:5433/scribe
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000

JWT_SECRET=docker-smoke-test-not-a-real-secret
JWT_EXPIRES_IN=8h

# AI_PROVIDER is overridden to "mock" by the verify command's `-e AI_PROVIDER=mock`; set here
# too so the file is a complete, correct standalone env on its own.
AI_PROVIDER=mock
AI_GENERATION_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AI_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
AI_EMBEDDING_DIMENSIONS=1024
