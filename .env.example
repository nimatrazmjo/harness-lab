# Shape only — no real values. Real secrets load from AWS Secrets Manager at runtime in
# staging/prod (see apps/api/src/config/secrets.ts). This file exists only to document what
# a local dev .env (git-ignored) needs to contain.

NODE_ENV=development

# --- API server ---
PORT=3000

# --- Database (local dev only — prod reads DATABASE_URL from Secrets Manager) ---
# Local dev target: infra/docker-compose.yml (postgres + pgvector), NOT real RDS.
DATABASE_URL=postgres://scribe:scribe@localhost:5433/scribe
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string-in-local-env
JWT_EXPIRES_IN=8h

# --- AWS (prod/staging only — never set these to real values in a committed file) ---
AWS_REGION=us-east-1
SECRETS_MANAGER_SECRET_ID=ai-clinical-scribe/prod

# --- AI provider (BAA-eligible) ---
# provider: "bedrock" | "mock" (mock is the local/dev/test default, no network calls)
AI_PROVIDER=mock
AI_GENERATION_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AI_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
AI_EMBEDDING_DIMENSIONS=1024
